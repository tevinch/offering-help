<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Tevinch</Authors>
    <Description>Static charts in a PDF report with an explicit SVG to PNG conversion.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TerraFluent.Chart.Reporting" Version="2.1.0" />
    <PackageReference Include="TerraFluent.Pdf.Reporting" Version="2.2.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
</Project>
