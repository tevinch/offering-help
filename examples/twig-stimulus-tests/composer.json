{
  "name": "example/twig-stimulus-tests",
  "description": "Shared Twig fixtures and layered Stimulus tests",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "symfony/framework-bundle": "8.1.9",
    "symfony/twig-bundle": "8.1.9",
    "symfony/asset-mapper": "8.1.9",
    "symfony/asset": "8.1.0",
    "symfony/stimulus-bundle": "3.6.0",
    "twig/twig": "3.30.0"
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.3",
    "symfony/browser-kit": "8.1.9",
    "symfony/css-selector": "8.1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  }
}
